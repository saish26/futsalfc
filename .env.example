# Base URL axios uses.
# Point it at the API directly (the API now sends CORS headers), or use "/backend"
# to go through the Next rewrite below instead.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Google *Web* OAuth client ID (Google Cloud Console > Credentials > OAuth client ID > Web application).
# Must match google.client_id in the API's config.yml. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Only used when NEXT_PUBLIC_API_BASE_URL is "/backend": where that rewrite forwards to.
API_PROXY_TARGET=http://localhost:8080
